# 百度地图开放平台密钥配置
# 复制本文件为 .env 并填入自己的 AK；.env 已被 .gitignore 排除，切勿提交。
# 申请地址：https://lbsyun.baidu.com/apiconsole/key

# 服务端 AK：后端调用 Web 服务 API（地理编码、地点检索、批量算路）
# 应用类型须选「服务端」，建议在控制台配置 IP 白名单
BAIDU_SERVER_AK=your_server_ak_here

# 浏览器端 AK：前端加载 JS API GL 渲染地图
# 应用类型须选「浏览器端」，Referer 白名单填 localhost/* 及正式域名
# 该 AK 会随前端代码暴露，安全性依赖 Referer 白名单
VITE_BAIDU_BROWSER_AK=your_browser_ak_here

# 限流与重试参数：运行 python scripts/probe_quota.py 实测后填入
# 下列默认值来自个人开发者免费额度的实测结果，详见 reports/quota-report.md
BAIDU_MAX_QPS=8
BAIDU_MATRIX_BATCH_SIZE=100
BAIDU_HTTP_TIMEOUT=30
BAIDU_MAX_RETRIES=3
BAIDU_RETRY_BACKOFF=0.5
