# 百度地图开放平台密钥配置
# 复制本文件为 .env 并填入自己的 AK；.env 已被 .gitignore 排除，切勿提交。
# 申请地址：https://lbsyun.baidu.com/apiconsole/key

# 服务端 AK：后端调用 Web 服务 API（地理编码、地点检索、批量算路）
# 应用类型须选「服务端」，建议在控制台配置 IP 白名单
BAIDU_SERVER_AK=your_server_ak_here

# 浏览器端 AK：前端加载 JS API GL 渲染地图
# 应用类型须选「浏览器端」，Referer 白名单填 localhost/* 及正式域名
# 该 AK 会随前端代码暴露，安全性依赖 Referer 白名单
VITE_BAIDU_BROWSER_AK=your_browser_ak_here

# 限流与重试参数：通常不用改。下列默认值来自个人开发者免费额度的实测，
# 详见 docs/api-optimization.md 第 4.1 节；换账号后可运行 python scripts/probe_quota.py 重测（会消耗少量配额）
BAIDU_MAX_QPS=8
BAIDU_MATRIX_BATCH_SIZE=100
BAIDU_HTTP_TIMEOUT=30
BAIDU_MAX_RETRIES=3
BAIDU_RETRY_BACKOFF=0.5

# 一次实时分析的总时长上限（秒）。含过街校正与圈内网格盲区，缓存为空时约 1~2 分钟
BAIDU_ANALYSIS_TIMEOUT=240
# 步行路网、路线、POI 缓存的有效期（天）。过期后重查，路网变化（新开通道、封路）才能体现
BAIDU_CACHE_TTL_DAYS=30
# 驾车实时路况视为「实时」的分钟数。过期条目不删除：接口失败时兜底并注明路况有多旧
BAIDU_TRAFFIC_TTL_MIN=10
# 批量算路同时在途的请求数（总速率仍受 BAIDU_MAX_QPS 限制）。1 为完全串行
BAIDU_MATRIX_CONCURRENCY=3
# 步行路线规划同时在途的请求数。实测 8 并发安全、12 触发限流
BAIDU_ROUTE_CONCURRENCY=4

# ---------- AI 二次核对（可选）----------
# 百度地图 Agent Plan 的 Token（sk-ap- 开头，申请：https://lbs.baidu.com/apiconsole/agentplan）。
# 配置后，灰色区域卡片里出现「AI 二次核对」：用 Agent Plan 的语义地点检索再找一遍缺口附近的
# 菜场、药店、小学，列出疑似漏收录的设施。不配不影响其他功能，按钮不显示。
# Token 只在后端使用，不会下发前端；Agent Plan 按调用扣额度，同样的问题只问一次（缓存 30 天）。
# scripts/crosscheck_poi.py（两份样例的核对报告）与 scripts/probe_agent_plan.py 也读它。
BAIDU_MAP_AUTH_TOKEN=

# ---------- 用户共享标注 ----------
# 管理员审核口令（至少 12 位）。不配则审核功能关闭，标注只能以「待核实」存在、只作为建议。
# 口令只在后端比对，不会下发前端；前端输入后只存在当前浏览器标签页里。
ADMIN_TOKEN=
# 设备标识加盐哈希用的盐。不配时首次运行自动生成并保存在 MARKINGS_DIR/salt。
MARKING_SALT=
# 标注数据库与照片目录，默认 data/user（不要放进 .cache，那里可以随手清掉）
# MARKINGS_DIR=
